# Logging settings
log_destination = 'stderr' # Logs to stderr, usually picked up by systemd/journald
logging_collector = on     # Enables logging to files

# Where to put log files
log_directory = 'log'      # Relative to the data directory, e.g., pg_log or log
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log' # Daily log files
log_file_mode = 0600       # Permissions on log files
log_truncate_on_rotation = on # Truncate existing log files if rotation is time-based
log_rotation_age = 1d      # Rotate logs daily
log_rotation_size = 0      # No size-based rotation

# Crucial for slow queries: Log queries taking longer than 250ms
log_min_duration_statement = 250 # in milliseconds. Set to a low value for testing (e.g., 0 for all queries)
                                 # but typically 100-1000 for production.
log_connections = on       # Log successful connections
log_disconnections = on    # Log disconnections
log_line_prefix = '%m %u@%d %p %r %h %q[%x] ' # Useful prefix for log entries
                                            # %m: timestamp
                                            # %u: user name
                                            # %d: database name
                                            # %p: process ID
                                            # %r: remote host and port
                                            # %h: remote host
                                            # %q: query tag (e.g., [1/1] for simple queries)
                                            # %x: transaction ID (if available)

# Other useful parameters for debugging
# log_statement = 'all' # Logs all statements - VERY VERBOSE, use only for short debugging!
# log_duration = on     # Logs duration of all statements, even if not logged by log_min_duration_statement