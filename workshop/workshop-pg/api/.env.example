# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/workshop_db?sslmode=disable

# Server Configuration
PORT=8080

# Database Pool Configuration for Performance Tuning
# Maximum number of connections in the pool
DB_MAX_CONNS=25

# Minimum number of connections maintained in the pool
DB_MIN_CONNS=5

# Maximum lifetime of a connection (in seconds) - 1 hour
DB_MAX_CONN_LIFETIME=3600

# Maximum idle time for a connection (in seconds) - 30 minutes
DB_MAX_CONN_IDLE_TIME=1800
